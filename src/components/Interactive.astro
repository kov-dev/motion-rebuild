---
// Markup as published by the Webflow build (ported 2026-11-18).
---

<section data-motion="theme" data-theme="light" class="section-interactive">
  <div data-motion="interactive" class="interactive-head"><h2 class="display-lg">Interactive</h2></div>
  <div data-motion="interactive-pin" class="interactive-pin">
    <div data-motion="interactive-track" class="interactive-track">
      <div class="interactive-item">
        <div class="interactive-text">
          <p class="body-sm is-strong">There are two types of<br />interactive interfaces:</p>
          <p class="body-sm"><span class="body-sm is-strong">Real-time</span> respond as users interact<br />with them.</p>
          <p class="body-sm"><span class="body-sm is-strong">Not real-time</span> respond after the interaction has taken place.</p>
        </div>
      </div>
      <div class="interactive-item">
        <div class="interactive-text"><p class="body-sm">Real-time</p></div>
        <div data-motion="interactive-sphere" class="interactive-sphere"></div>
      </div>
      <div class="interactive-item">
        <div class="interactive-text"><p class="body-sm">Not real-time</p></div>
        <div data-motion="interactive-lottie" aria-hidden="true" data-src="/assets/not_real_time.json" class="interactive-lottie"></div>
        <div data-motion="interactive-hover" class="interactive-hover"></div>
      </div>
    </div>
  </div>
</section>
