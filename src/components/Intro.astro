          stroke="currentColor"
        />
      </svg>
    </div>
    <div class="intro-path is-mobile w-embed">
      <!-- Intro ball path (mobile). Geometry only: invisible, read by motion.js (MotionPath). -->
      <svg viewBox="0 0 166 1405" fill="none" aria-hidden="true" focusable="false" style="display: block; width: 100%; height: auto; opacity: 0">
        <path
          data-motion="intro-path"
          data-bp="mobile"
          d="M57.6326 1C57.6326 1 81.0721 1 91 1C139.504 1 165 66 165 223C156.5 199 140.5 174 111 174C48.5 174 43.5 263 43.5 320.5C43.5 394.7 43.5 368.715 43.5 499.5C54.5 477.5 67.1106 456 90.5 456C147.207 456 156 564.239 156 695.5C151.5 669 122 625.5 79 625.5C36 625.5 1 659.5 1 741C1 822.5 1 1404 1 1404C5.5 1391 15.5 1383 29 1383C42.5 1383 54 1391 57 1404"
          stroke="currentColor"
        />
      </svg>
    </div>
  </div>
  <div class="ui-stage">
    <div data-motion="ui" class="ui-block">
      <div data-motion="ui-track" class="ui-rail">
        <div data-motion="ui-text" class="ui-heading">
          <h2 class="ui-title">UI/UX animation captures the mood of a brand or product and conveys it to a target audience</h2>
        </div>
        <div data-motion="ui-slides" class="ui-slides">
          <div data-motion="ui-slide" class="ui-panel">
            <div data-motion="ui-landing" class="ui-panel-body is-first">
              <div class="ui-media">
                <div class="ui-video w-embed">
                  <!-- UI slider, slide 1. Canon: src/intro/ui-videos.html -->
                  <video
                    data-motion="ui-video"
                    width="1406"
                    height="856"
                    preload="none"
                    loop
                    muted
                    playsinline
                    style="display: block; width: auto; height: 100%; opacity: 0"
                  >
                    <source src="https://cdn.zajno.com/dev/motion/videos/slider/optimise/1_GYM+2x_H.264.mp4" type="video/mp4" />
                  </video>
                </div>
              </div>
              <div class="ui-caption"><p class="body-sm">Here, animation gives a pumping vibe to a fitness website.</p></div>
            </div>
          </div>
          <div data-motion="ui-slide" class="ui-panel">
            <div class="ui-panel-body">
              <div class="ui-media">
