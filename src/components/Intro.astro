---
// Markup as published by the Webflow build (ported 2026-11-18).
---

<section data-theme="dark" data-motion="theme" class="section-intro">
  <div data-motion="intro" class="intro-scene">
    <div data-motion="intro-art" aria-hidden="true" class="intro-art">
      <div class="intro-illustration"></div>
      <div class="intro-clouds">
        <div data-motion="intro-cloud" class="intro-cloud is-left"></div>
        <div data-motion="intro-cloud" class="intro-cloud is-right"></div>
        <div data-layer="back" data-motion="intro-cloud" class="intro-cloud is-middle"></div>
      </div>
      <div class="intro-smoke"></div>
      <div class="intro-shape is-also">
        <div class="intro-shape-mask"><div data-step="0" data-motion="intro-text" class="text-shape">It also</div></div>
      </div>
      <div class="intro-shape is-controls">
        <div class="intro-shape-mask"><div data-step="1" data-motion="intro-text" class="text-shape">controls</div></div>
      </div>
      <div class="intro-shape is-your">
        <div class="intro-shape-mask"><div data-step="2" data-motion="intro-text" class="text-shape">your</div></div>
      </div>
      <div class="intro-shape is-attention">
        <div class="intro-shape-mask"><div data-step="3" data-motion="intro-text" class="text-shape">attention</div></div>
      </div>
    </div>
    <div class="intro-path w-embed">
      <!-- Intro ball path (desktop). Geometry only: invisible, read by motion.js (MotionPath). -->
      <svg viewBox="0 0 503 3498" fill="none" aria-hidden="true" focusable="false" style="display: block; width: 100%; height: auto; opacity: 0">
        <path
          data-motion="intro-path"
          data-bp="desktop"
          d="M178.874 47.5C178.874 47.5 213.85 1 281.802 1C514.138 1 501.646 515 501.646 515C501.646 515 435.693 443.5 309.282 443.5C159.888 443.5 73.4488 595.5 73.4488 803C73.4488 1010.5 73.4488 1192.3 73.4488 1519.5C95.933 1480 132.907 1450 196.862 1450C339.761 1450 467.67 1685 467.67 2074C435.693 2030.5 353.251 1978 239.831 1978C65.9541 1978 4.49753 2145 4.49753 2304C4.49753 2585 1 3090.04 1 3498"
          stroke="currentColor"
        />
      </svg>
    </div>
    <div class="intro-path is-tablet w-embed">
      <!-- Intro ball path (tablet). Geometry only: invisible, read by motion.js (MotionPath). -->
      <svg viewBox="0 0 289 2266" fill="none" aria-hidden="true" focusable="false" style="display: block; width: 100%; height: auto; opacity: 0">
        <path
          data-motion="intro-path"
          data-bp="tablet"
