                  </video>
                </div>
              </div>
              <div class="ui-caption"><p class="body-sm">It can also take game apps to the next level...</p></div>
            </div>
          </div>
          <div data-motion="ui-slide" class="ui-panel">
            <div class="ui-panel-body">
              <div class="ui-media">
