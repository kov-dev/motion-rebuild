---
// Markup as published by the Webflow build (ported 2026-11-18).
---

<div aria-hidden="true" data-motion="preloader" class="section-preloader">
  <div data-motion="preloader-scene" class="preloader-scene">
    <div data-motion="preloader-step" class="preloader-step">
      <p data-motion="preloader-word" class="preloader-word">Motion</p>
      <div data-motion="preloader-disc" class="preloader-disc"><p data-motion="preloader-word" class="preloader-word">Motion</p></div>
    </div>
    <div data-motion="preloader-step" class="preloader-step is-dark">
      <p data-motion="preloader-word" class="preloader-word">Design</p>
      <div data-motion="preloader-disc" class="preloader-disc is-light"><p data-motion="preloader-word" class="preloader-word">Design</p></div>
    </div>
    <div data-motion="preloader-step" class="preloader-step">
      <p data-motion="preloader-word" class="preloader-word">Principles</p>
      <div data-motion="preloader-disc" class="preloader-disc"><p data-motion="preloader-word" class="preloader-word">Principles</p></div>
    </div>
  </div>
  <div data-motion="preloader-loader" class="preloader-loader">
    <div class="preloader-bounce">
      <div data-motion="preloader-bounce-shadow" class="preloader-bounce-shadow"></div>
      <div data-motion="preloader-bounce-ball" class="preloader-bounce-ball"></div>
    </div>
    <p data-motion="preloader-counter" class="preloader-counter">0</p>
  </div>
</div>
