      <div class="lesson-schemes-stage">
        <div data-motion="schemes-track" class="lesson-schemes-track">
          <div
            data-text="With linear easing, the object travels at a constant speed, without acceleration or deceleration."
            data-motion="scheme"
            class="lesson-scheme is-active"
          >
            <div aria-hidden="true" data-motion="scheme-lottie" data-src="/assets/linear.json" class="lesson-scheme-lottie"></div>
            <div class="lesson-scheme-label">Linear</div>
          </div>
          <div data-text="Here the object accelerates slightly at the beginning and decelerates slightly at the end" data-motion="scheme" class="lesson-scheme">
            <div aria-hidden="true" data-motion="scheme-lottie" data-src="/assets/ease.json" class="lesson-scheme-lottie"></div>
            <div class="lesson-scheme-label">Ease</div>
          </div>
          <div data-text="Starts its movement slowly, but accelerates as it continues." data-motion="scheme" class="lesson-scheme">
            <div aria-hidden="true" data-motion="scheme-lottie" data-src="/assets/ease_in.json" class="lesson-scheme-lottie"></div>
            <div class="lesson-scheme-label">Ease-in</div>
