<section id="easing" data-motion="lesson" data-theme="color" data-wf--lesson-section--variant="easing" class="lesson-section">
  <div class="lesson-hero">
    <div aria-hidden="true" class="lesson-visual-row">
      <div class="lesson-star is-left"></div>
      <div data-src="/assets/1_easing_visual.json" data-motion="lesson-visual" data-kind="lottie" class="lesson-visual"></div>
