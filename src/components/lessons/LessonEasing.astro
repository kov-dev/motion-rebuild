          <div data-text="The opposite of ease-in - starts moving quickly and then slows down smoothly at the end." data-motion="scheme" class="lesson-scheme">
            <div aria-hidden="true" data-motion="scheme-lottie" data-src="/assets/ease_out.json" class="lesson-scheme-lottie"></div>
            <div class="lesson-scheme-label">Ease-out</div>
          </div>
          <div
            data-text="Cubic is similar to ease, but due to longer periods of acceleration and deceleration, the middle part of the path appears to pass more quickly."
            data-motion="scheme"
            class="lesson-scheme"
          >
