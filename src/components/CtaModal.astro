---
// Markup as published by the Webflow build (ported 2026-11-18).
---

<div aria-labelledby="cta-title" data-motion="cta-modal" role="dialog" aria-modal="true" class="cta-modal">
  <div data-motion="cta-backdrop" class="cta-backdrop"></div>
  <div data-lenis-prevent="true" data-motion="cta-panel" class="cta-panel">
    <div class="cta-head">
      <p class="text-label">Zajno × motion.ed</p>
      <button type="button" data-motion="cta-close" aria-label="Close" class="nb-pill nb-toggle">
        <span class="nb-toggle-label-wrap"><span class="nb-toggle-label">close</span></span
        ><span aria-hidden="true" class="nb-toggle-icon"><span class="nb-toggle-line is-x-top"></span><span class="nb-toggle-line is-x-bottom"></span></span>
      </button>
    </div>
    <h2 id="cta-title" class="heading-sm cta-title">Want motion like this in your product?</h2>
    <p class="body-md cta-text">We are Zajno, the studio behind this guide. Tell us about your project and we will get back to you.</p>
    <div class="cta-form-block w-form">
      <form
        method="post"
        name="wf-form-Project-request"
        data-name="Project request"
        data-motion="cta-form"
        id="cta-form"
        class="cta-form"
        data-wf-page-id="6ac8e84728488a6bd334f2e5"
        data-wf-element-id="95860475-3ddf-60d4-62c9-b14c09d6229e"
      >
        <div class="cta-row">
          <div class="cta-field">
            <label for="cta-name" class="text-label cta-label">Name</label
            ><input
              class="cta-input w-input"
              autocomplete="name"
              maxlength="256"
              name="Name"
              data-name="Name"
              placeholder="Example Text"
              type="text"
              id="cta-name"
              required=""
            />
          </div>
          <div class="cta-field">
            <label for="cta-email" class="text-label cta-label">Email</label
            ><input
              class="cta-input w-input"
              autocomplete="email"
              maxlength="256"
              name="Email"
              data-name="Email"
              placeholder="Example Text"
              type="email"
              id="cta-email"
              required=""
            />
          </div>
        </div>
        <div class="cta-field">
          <label for="cta-company" class="text-label cta-label">Company or website</label
          ><input
            class="cta-input w-input"
            autocomplete="organization"
            maxlength="256"
            name="Company"
            data-name="Company"
            placeholder="Example Text"
            type="text"
            id="cta-company"
          />
        </div>
        <div class="cta-field">
          <label for="cta-message" class="text-label cta-label">About the project</label
          ><textarea
            required=""
            placeholder="Example Text"
            maxlength="5000"
            id="cta-message"
            name="Message"
            data-name="Message"
            class="cta-input is-area w-input"
          ></textarea>
        </div>
        <div class="w-embed">
          <input type="hidden" name="Source" data-name="Source" data-motion="cta-source" /><input
            type="text"
            name="Check"
            data-name="Check"
            data-motion="cta-trap"
            tabindex="-1"
            autocomplete="off"
            aria-hidden="true"
            style="position: absolute; left: -9999px; width: 1px; height: 1px; opacity: 0"
          />
        </div>
        <input type="submit" data-wait="sending…" class="nb-pill is-invert w-button" value="send request" />
      </form>
      <div class="cta-done w-form-done">
        <p class="heading-sm cta-done-title">Thank you!</p>
        <p class="body-md">We have your request and will be in touch soon.</p>
      </div>
      <div class="cta-fail w-form-fail"><p class="body-sm">Something went wrong while sending the form. Please try again.</p></div>
    </div>
  </div>
</div>
